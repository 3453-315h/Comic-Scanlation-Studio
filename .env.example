# ==============================================================================
# SCANLATION TOOL - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your actual API keys
# DO NOT commit the .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Optional - for cloud sync)
# ------------------------------------------------------------------------------
# Get these from: https://console.firebase.google.com
# 1. Create a Firebase project
# 2. Enable Authentication, Firestore, and Storage
# 3. Copy your web app config here

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Service account JSON path (for admin operations)
GOOGLE_APPLICATION_CREDENTIALS=firebase/serviceAccountKey.json

# ------------------------------------------------------------------------------
# TRANSLATION APIS (Choose at least ONE)
# ------------------------------------------------------------------------------

# DeepL API (Recommended for quality)
# Get key from: https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month
DEEPL_API_KEY=your_deepl_api_key_here

# OpenAI API (Best for context-aware translation)
# Get key from: https://platform.openai.com/api-keys
# Costs vary by usage
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum image dimension (pixels)
MAX_IMAGE_SIZE=4096

# Default languages
DEFAULT_SOURCE_LANG=ja
DEFAULT_TARGET_LANG=en
